
// Criando a variável que define se o jogo será jogado em dois jogadores ou um só
global.dois_jogadores = false;

// Criando a variável que salva a velocidade vertical da bola
global.vspe = 0;

// Criando a variável dos pontos dos jogadores
global.pontosp1 = 0;
global.pontosp2 = 0;

// Criando uma variável de controle para poder resetar a posição da raquete adversária quando ocorrer um gol
global.resetar = false;

// Criando a variável de pontos maximos
global.max_pontos = 2;